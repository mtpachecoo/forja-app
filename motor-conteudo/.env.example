# Copie para .env e preencha com valores reais — nunca commitar .env.
#
# Mesmo Neon/Voyage usados pelo backend C# (Forja.Api), mas lidos aqui de um
# .env próprio do motor-conteudo — projeto Python independente, sem
# referência ao .env do C#. Os valores tendem a ser os mesmos, colados de lá
# pra cá.

# Connection string do Postgres (Neon), formato URI padrão — psycopg aceita
# esse formato nativamente, sem conversão nenhuma.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# API key da Voyage AI (mesma conta usada pelo Forja.Api para RAG/dúvidas).
VOYAGE_API_KEY=your-voyage-api-key

# API key do Gemini (mesma conta usada pelo Forja.Api para RAG de dúvidas — Gemini__ApiKey
# no .env do backend), usada aqui pra extração estruturada de questões (gemini-2.5-flash).
GEMINI_API_KEY=your-gemini-api-key
