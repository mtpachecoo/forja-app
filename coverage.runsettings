<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>opencover</Format>

          <!-- IncludeTestAssembly=false (o padrão) já mantém os próprios assemblies de teste fora
               da instrumentação — os filtros abaixo cobrem código gerado/infra que não deve contar
               pra métricas de risco (Migrations do EF, designers, código com atributo de geração). -->
          <ExcludeByFile>
            **/Migrations/**/*.cs,
            **/*.Designer.cs,
            **/*.g.cs,
            **/*.g.i.cs,
            **/obj/**/*.cs
          </ExcludeByFile>

          <!-- CompilerGeneratedAttribute NÃO entra aqui: a state machine gerada pelo compilador para
               métodos async carrega esse atributo, e excluí-lo apaga o corpo inteiro de todo método
               async (a esmagadora maioria da camada de aplicação) da instrumentação — reduzindo cada
               método a um único sequence point trivial e invalidando qualquer métrica de risco (CRAP)
               calculada em cima disso. -->
          <ExcludeByAttribute>
            Obsolete,
            GeneratedCodeAttribute,
            ExcludeFromCodeCoverageAttribute
          </ExcludeByAttribute>

          <Exclude>
            [*.Tests]*,
            [*.Tests.*]*,
            [*]*.Migrations.*
          </Exclude>

          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
